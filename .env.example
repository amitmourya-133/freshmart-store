# FreshMart environment variables
# Copy this file to .env and fill in real values for local development.
# On Vercel, set the SAME variable names in Project Settings > Environment Variables.

# MongoDB connection string (MongoDB Atlas or local). REQUIRED for the backend.
MONGODB_URI=mongodb://localhost:27017/freshmart

# Secret used to sign JWT auth tokens. REQUIRED.
# Use a long random string, e.g. generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Port used by the local Express server (Vercel ignores this).
PORT=5000

# Email delivery for login OTPs. Configure ONE option:
#
# Option A - Generic SMTP (recommended; works with any provider):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=FreshMart <no-reply@example.com>     # optional "From" header
#
# Option B - Legacy Gmail account (App Password required):
# EMAIL_USER=youraddress@gmail.com
# EMAIL_PASS=your_gmail_app_password
#
# If neither is configured, OTP emails are silently skipped (nothing is logged
# and no OTP is ever returned by the API). Deliverability is verified via the
# emailSent flag in the send-otp response.
#
# Optional: secret required to create additional admins via /api/users/admin/setup.
ADMIN_SECRET=
# Optional: defaults when seeding an admin with `npm run seed:admin`.
ADMIN_EMAIL=admin@freshmart.com
ADMIN_PASSWORD=admin123

# Optional: Google Sign-In (real OAuth 2.0 authorization-code flow).
# 1. Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# 2. Add the exact redirect URI below to the client's "Authorized redirect URIs".
# 3. Set these three variables locally AND on Vercel (same names):
# GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REDIRECT_URI=https://freshmart-store-jet.vercel.app/login.html
# Without all three, the "Sign in with Google" button reports "not configured"
# and never sends anything to Google (no fake/demo sign-in is performed).